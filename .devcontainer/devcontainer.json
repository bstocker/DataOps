{
  "name": "Atelier DataOps",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "containerEnv": {
    "MLFLOW_DISABLE_AGENT_HINT": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt && python scripts/generer_donnees.py && chmod +x verifier.sh mlflow-ui.sh",
  "forwardPorts": [5000, 8000],
  "portsAttributes": {
    "5000": { "label": "MLflow", "onAutoForward": "openBrowser" },
    "8000": { "label": "API", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "mechatroner.rainbow-csv"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "files.autoSave": "afterDelay",
        "git.enableSmartCommit": true,
        "git.confirmSync": false
      }
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
